{
  "name": "step-terminal",
  "productName": "stepbro terminal",
  "version": "0.1.0-beta.30",
  "private": true,
  "description": "stepbro terminal",
  "author": {
    "name": "Kevin",
    "email": "roloocoste@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/stepbro-lab/StepbroTerminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepbro-lab/StepbroTerminal.git"
  },
  "bugs": {
    "url": "https://github.com/stepbro-lab/StepbroTerminal/issues"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/pty-helper-exec.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build && electron-builder --linux",
    "dmg:background": "electron scripts/dmg-background.cjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "node-pty": "^1.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.475.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "@resvg/resvg-js"
    ],
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    },
    "overrides": {
      "vitest>tinypool": "^2.1.2"
    }
  }
}
